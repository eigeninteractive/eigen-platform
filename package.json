{
  "name": "eigen-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Monorepo and workspace for the EigenInteractive Backend",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "openapi": "pnpm --filter @eigeninteractive/server openapi",
    "dart-client": "scripts/generate-dart-client.sh",
    "changeset": "changeset",
    "version-packages": "node scripts/follow-engine-line.mjs && changeset version && pnpm openapi && scripts/generate-dart-client.sh"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "3.0.0-next.10",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
