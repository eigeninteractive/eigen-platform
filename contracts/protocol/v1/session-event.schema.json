{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigeninteractive.com/contracts/protocol/v1/session-event.schema.json",
  "title": "EigenInteractive complete session event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolMajor", "streamSeq", "gameId", "contractId", "version", "session"],
  "properties": {
    "type": { "const": "session" },
    "protocolMajor": { "const": 1 },
    "streamSeq": { "type": "integer", "minimum": 1 },
    "gameId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*/sha256:[0-9a-f]{64}$"
    },
    "version": { "type": "integer", "minimum": 0 },
    "committedCommandId": { "type": "string", "format": "uuid" },
    "session": {
      "type": "object",
      "description": "A complete, authenticated per-seat session defined by the selected game contract."
    }
  }
}
