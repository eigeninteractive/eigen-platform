{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigeninteractive.com/contracts/protocol/v1/client-capabilities.schema.json",
  "title": "EigenInteractive client capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolMajor", "features", "gameContracts", "client"],
  "properties": {
    "$schema": { "type": "string" },
    "protocolMajor": { "const": 1 },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "gameContracts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractId" }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": {
          "type": "string",
          "enum": ["android", "ios", "web", "macos", "windows", "linux", "server", "test"]
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[1-9][0-9]*$",
      "maxLength": 80
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*/sha256:[0-9a-f]{64}$",
      "maxLength": 160
    }
  }
}
