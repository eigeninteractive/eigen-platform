{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigeninteractive.com/contracts/game/v1/game-contract.schema.json",
  "title": "EigenInteractive game contract manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "contractId", "game", "version", "lifecycle", "compatibility", "creation", "schemas", "client"],
  "properties": {
    "$schema": { "type": "string" },
    "profileVersion": { "const": 1 },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*/sha256:[0-9a-f]{64}$"
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "lifecycle": {
      "type": "string",
      "enum": ["create", "readable", "replayOnly", "retired"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolMajor", "requiredFeatures"],
      "properties": {
        "protocolMajor": { "const": 1 },
        "requiredFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
          }
        }
      }
    },
    "creation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "players", "timingModes", "bots", "rating"],
      "properties": {
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["public", "private"] }
        },
        "players": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": { "type": "string", "enum": ["fixed", "fromConfig"] },
            "minimum": { "type": "integer", "minimum": 1, "maximum": 32 },
            "maximum": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        },
        "timingModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "turnSeconds", "budgetSeconds", "incrementSeconds"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "turnSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 },
              "budgetSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 604800 },
              "incrementSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 }
            }
          }
        },
        "bots": { "type": "string", "enum": ["forbidden", "allowedByRules"] },
        "rating": { "type": "string", "enum": ["unrated", "poolFromRules"] }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "state", "action", "observation"],
      "properties": {
        "config": { "$ref": "#/$defs/embeddedSchema" },
        "state": { "$ref": "#/$defs/embeddedSchema" },
        "action": { "$ref": "#/$defs/embeddedSchema" },
        "observation": { "$ref": "#/$defs/embeddedSchema" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendererKey", "prediction"],
      "properties": {
        "rendererKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$" },
        "prediction": { "type": "string", "enum": ["none", "optional"] }
      }
    }
  },
  "$defs": {
    "embeddedSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "type": {}
      }
    }
  }
}
