{
  "name": "@eigeninteractive/rules",
  "version": "0.2.4",
  "license": "MIT",
  "description": "The game-rules contract for the EigenInteractive engine: GameRules, GameModule, the hooks, and the Envelope/Observation types. Pure types, zero engine dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "eigen",
    "game-engine",
    "turn-based",
    "multiplayer",
    "cloudflare-workers",
    "durable-objects"
  ],
  "author": "EigenInteractive",
  "type": "module",
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "homepage": "https://eigeninteractive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigeninteractive/eigen-server.git",
    "directory": "packages/rules"
  },
  "bugs": {
    "url": "https://github.com/eigeninteractive/eigen-server/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
