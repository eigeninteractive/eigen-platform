{
  "name": "@eigen/server",
  "version": "1.0.0",
  "description": "Deployable engine host for the Eigen Server: GameDO + routes + D1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "openapi": "tsup && node scripts/emit-openapi.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p tsconfig.canary.json",
    "db:generate:do": "drizzle-kit generate --config drizzle-do.config.ts",
    "db:generate:d1": "drizzle-kit generate --config drizzle-d1.config.ts"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@eigen/kernel": "workspace:*",
    "@eigen/rules": "workspace:*",
    "@hono/zod-openapi": "^1.5.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "openapi3-ts": "4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "drizzle-kit": "^0.31.10"
  }
}
