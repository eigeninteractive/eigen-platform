{
  "name": "create-eigen-game",
  "version": "0.9.0",
  "license": "MIT",
  "description": "Scaffold an EigenInteractive game Worker and Flutter app without cloning the engine repositories.",
  "type": "module",
  "bin": {
    "create-eigen-game": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p templates/worker/tsconfig.json"
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eigeninteractive/rules": "workspace:*",
    "@eigeninteractive/server": "workspace:*",
    "@eigeninteractive/testkit": "workspace:*",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigeninteractive/eigen-server.git",
    "directory": "packages/create-eigen-game"
  }
}
