{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "class_name": "GameDO", "name": "GAME_DO" }]
  },
  "exports": {
    "GameDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "FIREBASE_PROJECT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "GAME_DB",
      "migrations_dir": "node_modules/@eigeninteractive/server/migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
