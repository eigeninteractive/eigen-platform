{
  "name": "@eigen/testkit",
  "version": "1.0.0",
  "description": "Testing Kit for the Eigen Server",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@eigen/kernel": "workspace:*",
    "@eigen/rules": "workspace:*",
    "rand-seed": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": "^4.1.0"
  }
}
