{
  "name": "@eigeninteractive/testkit",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Test helpers for games built on the Eigen engine: drive rules through the real kernel and run shared twin fixtures, with no Worker, database or network.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "eigen",
    "game-engine",
    "turn-based",
    "multiplayer",
    "cloudflare-workers",
    "durable-objects"
  ],
  "author": "Eigen Interactive",
  "type": "module",
  "dependencies": {
    "@eigeninteractive/kernel": "workspace:*",
    "@eigeninteractive/rules": "workspace:*",
    "rand-seed": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": "^4.1.0"
  },
  "homepage": "https://eigeninteractive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigeninteractive/eigen-server.git",
    "directory": "packages/testkit"
  },
  "bugs": {
    "url": "https://github.com/eigeninteractive/eigen-server/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
