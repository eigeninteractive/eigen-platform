        "state": {
          "round": 2,
          "wins": [0, 1],
          "commits": [null, null],
          "lastRound": { "moves": ["rock", "paper"], "winner": 1 }
        },
        "pending": [],
        "outcome": [{ "playerIndex": 1, "result": "win", "placement": 1, "teamIndex": 1 }, { "playerIndex": 0, "result": "loss", "placement": 2, "teamIndex": 0 }]
      }
    },
    {
      "kind": "transcript",
      "name": "a best-of-one played to its finish",
      "config": { "targetWins": 1 },
      "playerCount": 2,
      "seed": "rps-twin-transcript",
