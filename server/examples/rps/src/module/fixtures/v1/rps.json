    {
      "kind": "playerLimits",
      "name": "rps is exactly two seats, whatever the target",
      "config": { "targetWins": 3 },
      "expected": { "minPlayers": 2, "maxPlayers": 2 }
    },
    {
      "kind": "ratingPool",
      "name": "public games rate in the standard pool",
      "access": "public",
      "minPlayers": 2,
      "maxPlayers": 2,
      "config": { "targetWins": 3 },
      "expected": "standard"
    },
    {
      "kind": "ratingPool",
      "name": "private games are unrated",
      "access": "private",
      "minPlayers": 2,
      "maxPlayers": 2,
      "config": { "targetWins": 3 },
      "expected": null
    },
    {
      "kind": "botSeatable",
      "name": "rps seats every bot",
      "gameConfig": { "targetWins": 3 },
      "botConfig": {},
      "expected": true
    },
    {
      "kind": "initialState",
      "name": "a best-of-one opens with both seats pending",
      "config": { "targetWins": 1 },
      "playerCount": 2,
