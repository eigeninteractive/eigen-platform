        "state": { "round": 1, "wins": [0, 0], "commits": [null, null], "lastRound": null },
        "pending": [0, 1],
        "outcome": null
      }
    },
    {
      "kind": "initialState",
      "name": "the target does not change the opening position",
      "config": { "targetWins": 3 },
      "playerCount": 2,
      "expected": {
        "state": { "round": 1, "wins": [0, 0], "commits": [null, null], "lastRound": null },
        "pending": [0, 1],
        "outcome": null
      }
    },
    {
      "kind": "lifecycle",
