          "round": 2,
          "wins": [0, 0],
          "lastRound": { "moves": ["paper", "paper"], "winner": null },
          "yourMove": null
        }
      }
    },
    {
      "kind": "action",
      "name": "a decided round below targetWins continues the match",
      "config": { "targetWins": 2 },
      "state": {
        "round": 1,
        "wins": [0, 0],
        "commits": [null, "paper"],
        "lastRound": null
      },
      "obs": {
        "round": 1,
        "wins": [0, 0],
        "lastRound": null,
        "yourMove": null
