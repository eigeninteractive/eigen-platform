      "expected": {
        "version": 2,
        "status": "finished",
        "state": {
          "round": 1,
          "wins": [1, 0],
          "commits": [null, null],
          "lastRound": { "moves": ["rock", "scissors"], "winner": 0 }
        },
        "pending": [],
        "outcome": [{ "playerIndex": 0, "result": "win", "placement": 1, "teamIndex": 0 }, { "playerIndex": 1, "result": "loss", "placement": 2, "teamIndex": 1 }]
      }
    },
    {
      "kind": "transcript",
      "name": "a best-of-three abandoned by the human seat",
      "config": { "targetWins": 3 },
      "playerCount": 2,
      "seed": "rps-twin-transcript",
      "transitions": [{ "kind": "game", "playerIndex": 0, "data": { "move": "rock" } }, { "kind": "game", "playerIndex": 1, "data": { "move": "paper" } }, { "kind": "lifecycle", "type": "forfeit", "playerIndex": 0 }],
