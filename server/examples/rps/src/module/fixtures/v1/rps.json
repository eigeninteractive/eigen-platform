    {
      "kind": "action",
      "name": "committing twice in one round is illegal",
      "config": { "targetWins": 1 },
      "state": {
        "round": 1,
        "wins": [0, 0],
        "commits": ["rock", null],
        "lastRound": null
      },
      "obs": {
        "round": 1,
        "wins": [0, 0],
        "lastRound": null,
        "yourMove": "rock"
      },
      "pending": [1],
      "playerIndex": 0,
      "action": { "move": "paper" },
      "expected": { "valid": false }
