{
  "schemaVersion": 1,
  "cases": [
    {
      "kind": "action",
      "name": "first commit of a round is recorded and hidden",
      "config": { "targetWins": 1 },
      "state": {
        "round": 1,
        "wins": [0, 0],
        "commits": [null, null],
        "lastRound": null
      },
      "obs": {
        "round": 1,
        "wins": [0, 0],
        "lastRound": null,
        "yourMove": null
      },
      "pending": [0, 1],
      "playerIndex": 0,
      "action": { "move": "rock" },
      "expected": {
        "valid": true,
        "state": {
          "round": 1,
          "wins": [0, 0],
          "commits": ["rock", null],
          "lastRound": null
        },
        "pending": [1],
        "outcome": null,
        "observation": {
          "round": 1,
          "wins": [0, 0],
          "lastRound": null,
          "yourMove": "rock"
        }
      }
    },
    {
      "kind": "action",
      "name": "second commit resolves the round and the match at targetWins 1",
      "config": { "targetWins": 1 },
      "state": {
        "round": 1,
        "wins": [0, 0],
        "commits": ["rock", null],
        "lastRound": null
      },
      "obs": {
        "round": 1,
        "wins": [0, 0],
        "lastRound": null,
        "yourMove": null
      },
      "pending": [1],
      "playerIndex": 1,
      "action": { "move": "scissors" },
      "expected": {
        "valid": true,
        "state": {
          "round": 1,
          "wins": [1, 0],
          "commits": [null, null],
          "lastRound": { "moves": ["rock", "scissors"], "winner": 0 }
        },
        "pending": [],
        "outcome": [{ "playerIndex": 0, "result": "win", "placement": 1, "teamIndex": 0 }, { "playerIndex": 1, "result": "loss", "placement": 2, "teamIndex": 1 }],
        "observation": {
          "round": 1,
          "wins": [1, 0],
          "lastRound": { "moves": ["rock", "scissors"], "winner": 0 },
          "yourMove": null
        }
      }
    },
    {
      "kind": "action",
      "name": "a drawn round advances the round with no win",
      "config": { "targetWins": 2 },
      "state": {
        "round": 1,
        "wins": [0, 0],
        "commits": ["paper", null],
        "lastRound": null
      },
      "obs": {
        "round": 1,
        "wins": [0, 0],
        "lastRound": null,
        "yourMove": null
      },
      "pending": [1],
      "playerIndex": 1,
      "action": { "move": "paper" },
      "expected": {
        "valid": true,
        "state": {
          "round": 2,
          "wins": [0, 0],
          "commits": [null, null],
          "lastRound": { "moves": ["paper", "paper"], "winner": null }
