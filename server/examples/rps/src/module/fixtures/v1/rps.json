    },
    {
      "kind": "transcript",
      "name": "a best-of-three mid-round, waiting on the human",
      "config": { "targetWins": 3 },
      "playerCount": 2,
      "seed": "rps-twin-transcript",
      "transitions": [{ "kind": "game", "playerIndex": 0, "data": { "move": "rock" } }, { "kind": "game", "playerIndex": 1, "data": { "move": "scissors" } }, { "kind": "game", "playerIndex": 1, "data": { "move": "paper" } }],
