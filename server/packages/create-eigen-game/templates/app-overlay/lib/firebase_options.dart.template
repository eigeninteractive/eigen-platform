import 'package:firebase_core/firebase_core.dart';

/// Firebase configuration generated by the FlutterFire CLI.
///
/// The scaffold keeps this throwing implementation so the project compiles
/// before Firebase is connected. `pnpm firebase:configure` or
/// `npm run firebase:configure` replaces this file with FlutterFire's generated
/// platform configuration.
abstract final class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform => throw StateError(
    'Firebase is not configured. Run `pnpm firebase:configure` or '
    '`npm run firebase:configure` from the project root.',
  );
}
