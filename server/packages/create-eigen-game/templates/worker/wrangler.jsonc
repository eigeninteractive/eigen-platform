{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "class_name": "GameDO", "name": "GAME_DO" }]
  },
  "exports": {
    "GameDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Non-secret Worker environment variables, used by local development and
  // uploaded with every deployment.
  "vars": {
    "FIREBASE_PROJECT_ID": "",
    // Trusted automatically for browser API/socket access and used for
    // absolute notification click links.
    "WEB_APP_ORIGIN": "http://localhost:7357"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/avatars/*", "/.well-known/*", "/join/*", "/game/*", "/download", "/terms", "/privacy", "/delete-account", "/robots.txt", "/sitemap.xml", "/site.webmanifest"]
  },
  "d1_databases": [
    {
      "binding": "GAME_DB",
      "migrations_dir": "node_modules/@eigeninteractive/server/migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
