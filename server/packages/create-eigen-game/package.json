{
  "name": "create-eigen-game",
  "version": "0.17.7",
  "license": "MIT",
  "description": "Scaffold an EigenInteractive game Worker and Flutter app without cloning the engine repositories.",
  "type": "module",
  "bin": {
    "create-eigen-game": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p templates/worker/tsconfig.json"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eigeninteractive/rules": "workspace:*",
    "@eigeninteractive/server": "workspace:*",
    "@eigeninteractive/testkit": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigeninteractive/eigen-platform.git",
    "directory": "server/packages/create-eigen-game"
  },
  "bugs": {
    "url": "https://github.com/eigeninteractive/eigen-platform/issues"
  }
}
