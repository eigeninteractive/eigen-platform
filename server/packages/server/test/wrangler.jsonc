/**
 * Test-only worker config for @eigeninteractive/server's vitest-pool-workers suite.
 * never deployed. Binds the GameDO produced by createGameDO plus a simulated
 * D1 database.
 */
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "eigen-server-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // external-bot HMAC secret + the operator surface secret (a real deploy sets
  // both with `wrangler secret`).
  "vars": { "BOT_SIGNING_SECRET": "test-bot-signing-secret", "OPS_TOKEN": "test-ops-token" },
  "exports": {
    "GameDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GameDO",
        "name": "GAME_DO"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eigen-test",
      "database_id": "eigen-test"
    }
  ],
  // avatars: simulated R2 under vitest-pool-workers (.wrangler/state); no
  // real bucket, no card. Exercises the upload/serve/purge routes.
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "eigen-test-avatars" }],
  // The drizzle durable-sqlite migrations.js imports its .sql as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
