{
  "name": "eigen-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Monorepo and workspace for the EigenInteractive Backend",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter \"./packages/*\" --parallel run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "openapi": "pnpm --filter @eigeninteractive/server openapi",
    "dart-client": "scripts/generate-dart-client.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm --filter \"@eigeninteractive/server^...\" build && pnpm openapi && scripts/generate-dart-client.sh && pnpm --dir ../web sync-api && node ../tool/platform.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "3.0.0",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
