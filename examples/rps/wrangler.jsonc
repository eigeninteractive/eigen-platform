/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rps",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "exports": {
    "GameDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // The worker is the link host. Static files live in ./public and are
  // served UNMETERED by the asset server. No `run_worker_first` is needed: a
  // request that matches no static file already falls through to the Worker, so
  // the dynamic paths (the API, the generated .well-known files, the /j share
  // page, worker-served avatars, and the generated site pages) reach it on
  // their own.
  //
  // That precedence cuts both ways, and is the override mechanism for the
  // engine's generated pages: a `public/terms.html` would be served at /terms
  // instead of the engine's, and a `public/index.html` would replace the
  // generated landing page. Deliberate here — ./public is empty so this example
  // shows the engine's own pages — but it means never adding a file under
  // ./public whose path shadows one you did not mean to replace.
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GameDO",
        "name": "GAME_DO"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // The only value token verification needs. Set to the Firebase project
    // id before deploying; empty makes every request fail 500.
    "FIREBASE_PROJECT_ID": ""
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "rps_dev",
      "database_name": "rps-dev",
      "database_id": "4f5e2940-1262-4b4b-9551-c19364e86509",
      // Engine-owned schema, like the DO's: migrations ship inside
      // @eigen/server and `deploy` applies them before the code goes out.
      // App-custom data belongs in a SEPARATE second d1_databases entry with
      // its own migrations_dir — never in this database.
      "migrations_dir": "node_modules/@eigen/server/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "eigeninteractive-rps-avatars-dev"
    }
  ],
  // Per-user write rate limits. The engine wires each entry by its conventional
  // `EIGEN_RATE_LIMIT_*` name, so no code is needed in index.ts — this block is
  // the entire setup, and the limits below are the recommended starting values.
  // The `limit`/`period` here are the source of truth (the engine reads
  // neither); `period` is 10 or 60 only. `namespace_id` is a positive integer
  // that must be unique WITHIN your Cloudflare account — ids are account-scoped,
  // so a value reused by another Worker would share counters. Per-colo,
  // eventually consistent — an abuse dampener, not a hard quota.
  "ratelimits": [
    { "name": "EIGEN_RATE_LIMIT_AVATAR_UPLOAD", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "EIGEN_RATE_LIMIT_GAME_CREATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "EIGEN_RATE_LIMIT_FRIEND_REQUEST", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "EIGEN_RATE_LIMIT_USER_SEARCH", "namespace_id": "1004", "simple": { "limit": 20, "period": 10 } }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
